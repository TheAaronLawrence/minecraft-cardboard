# Blocks `cargo xtask gen-world` places with /setblock: x y z state.
# Spaced apart in the sky so no block updates another, and limited to blocks that keep the
# exact state placed (no falling, flowing, scheduled ticks, redstone power changes, or
# block entities that rewrite their state, like brewing stands).
# They straddle x = 0 so both the -1 and 0 region files are covered.
-24 250 1 minecraft:stone
-21 250 1 minecraft:oak_stairs[facing=west,half=top,shape=outer_left,waterlogged=true]
-18 250 1 minecraft:oak_log[axis=x]
-15 250 1 minecraft:chest[facing=east,type=left,waterlogged=false]
-12 250 1 minecraft:glass_pane[east=true,north=false,south=true,west=false,waterlogged=false]
-9 250 1 minecraft:cobblestone_wall[east=none,north=low,south=tall,up=false,waterlogged=false,west=none]
-6 250 1 minecraft:oak_slab[type=top,waterlogged=false]
-3 250 1 minecraft:grass_block[snowy=true]
0 250 1 minecraft:lantern[hanging=true,waterlogged=false]
3 250 1 minecraft:furnace[facing=south,lit=true]
6 250 1 minecraft:end_rod[facing=down]
9 250 1 minecraft:cake[bites=3]
12 250 1 minecraft:oak_sign[rotation=7,waterlogged=false]
15 250 1 minecraft:smooth_stone_slab[type=double,waterlogged=false]
18 250 1 minecraft:amethyst_cluster[facing=north,waterlogged=false]
24 250 -2 minecraft:diamond_block
24 250 -5 minecraft:cherry_trapdoor[facing=south,half=top,open=true,powered=false,waterlogged=false]
-27 250 1 minecraft:chest[facing=south,type=single,waterlogged=false]
-30 250 1 minecraft:ender_chest[facing=north,waterlogged=false]
-33 250 1 minecraft:red_banner[rotation=0]
-36 250 1 minecraft:blue_wall_banner[facing=south]
-39 250 1 minecraft:shulker_box[facing=up]
-42 250 1 minecraft:lime_shulker_box[facing=north]
-45 250 1 minecraft:skeleton_skull[powered=false,rotation=8]
-48 250 1 minecraft:creeper_wall_head[facing=south,powered=false]
-51 250 1 minecraft:zombie_head[powered=false,rotation=6]
-54 250 1 minecraft:dragon_head[powered=false,rotation=8]
-57 250 1 minecraft:piglin_head[powered=false,rotation=10]
-60 250 1 minecraft:player_head[powered=false,rotation=8]
-63 250 1 minecraft:wither_skeleton_wall_skull[facing=south,powered=false]
-66 250 1 minecraft:decorated_pot[cracked=false,facing=south,waterlogged=false]
-69 250 1 minecraft:conduit[waterlogged=false]
-72 250 1 minecraft:copper_golem_statue[copper_golem_pose=standing,facing=south,waterlogged=false]
-75 250 1 minecraft:exposed_copper_golem_statue[copper_golem_pose=sitting,facing=south,waterlogged=false]
-78 250 1 minecraft:weathered_copper_golem_statue[copper_golem_pose=running,facing=south,waterlogged=false]
-81 250 1 minecraft:oxidized_copper_golem_statue[copper_golem_pose=star,facing=south,waterlogged=false]
-84 250 1 minecraft:end_portal
-87 250 1 minecraft:end_gateway
# Block entity data, in a column along x = 24 facing east.
24 250 -8 minecraft:white_banner[rotation=12]{patterns:[{pattern:"minecraft:stripe_top",color:"red"},{pattern:"minecraft:creeper",color:"black"},{pattern:"minecraft:border",color:"blue"}]}
24 250 -11 minecraft:yellow_wall_banner[facing=east]{patterns:[{pattern:"minecraft:gradient",color:"purple"}]}
